# Caches de Python, reconstruits à chaque exécution.
__pycache__/
*.py[cod]

# Cruft d'éditeur et de système.
.DS_Store
*~
.idea/
.vscode/

# Runtime state written by deploy/auto-deploy.sh, not part of the source.
.deploy.log
.deployed-commit

# Source scans kept for local reference only — never committed or served.
# The full copyrighted Graduale Triplex must not end up in git history or
# under public/ (Dockerfile ships public/ wholesale to the live site).
/source-material/

# Real SMTP credentials for the feedback mail service. Never committed —
# see .env for the placeholder documenting the expected variables.
/.env.local

# Basic-auth credentials for the /stats/ GoAccess dashboard. Generated
# locally on the server, never committed — see README for how to regenerate.
/docker/nginx/.htpasswd-stats

# Static offline preview export (flattened HTML/CSS/assets), regenerated
# on demand — not part of the Symfony app's source.
/preview/
