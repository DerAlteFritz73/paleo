{#
   base.html.twig — gabarit principal du blog « Paléo »
   ---------------------------------------------------------------------------
   Chaque page étend ce gabarit :  {% extends 'base.html.twig' %}
   puis remplit les blocs  {% block titre %}  et  {% block contenu %}.

   La variable  nav_actif  (définie dans chaque page via {% set nav_actif = '...' %})
   sert à surligner l'onglet courant dans le menu.

   Les liens utilisent path('nom_de_route') : voir src/Controller/PaleoController.php
   pour la correspondance route ↔ page.  Pendant l'ébauche, si les routes ne sont
   pas encore créées, remplacez temporairement path('paleo_xxx') par une URL en dur.
#}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block titre %}Paléo{% endblock %} — Paléo, le chant grégorien pas à pas</title>
    <meta name="description" content="{% block meta_description %}Découvrir les neumes et le chant grégorien à travers le Graduale Triplex. Un blog de vulgarisation pour débutants.{% endblock %}">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block head %}{% endblock %}
</head>
<body>
    <header class="site-header">
        <div class="bandeau">
            <h1 class="titre-site"><a href="{{ path('paleo_index') }}">Vous avez dit «&nbsp;grégorien&nbsp;»&nbsp;?</a></h1>
            <p class="sous-titre">Le chant grégorien et ses neumes, expliqués pas à pas</p>
            <nav class="choix-langue" aria-label="Choix de la langue">
                <span class="langue-actuelle" aria-current="true" lang="fr">FR</span>
                <a href="{{ path(route_de) }}" lang="de" hreflang="de" title="Diese Seite auf Deutsch">DE</a>
                <a href="{{ path(route_en) }}" lang="en" hreflang="en" title="This page in English">EN</a>
            </nav>
        </div>
    </header>

    <div class="page-layout">
        <nav class="site-nav" aria-label="Navigation principale">
            <ul>
                <li><a href="{{ path('paleo_index') }}"     {{ nav_actif == 'accueil'  ? 'aria-current="page"' : '' }}>Accueil</a></li>
                <li><a href="{{ path('paleo_histoire') }}"   {{ nav_actif == 'histoire' ? 'aria-current="page"' : '' }}>Le grégorien&nbsp;?</a></li>
                <li><a href="{{ path('paleo_notation') }}"   {{ nav_actif == 'notation' ? 'aria-current="page"' : '' }}>Les bases</a></li>
                <li><a href="{{ path('paleo_triplex') }}"    {{ nav_actif == 'triplex'  ? 'aria-current="page"' : '' }}>Le Graduale Triplex</a></li>
                <li><a href="{{ path('paleo_puer') }}"       {{ nav_actif == 'puer'     ? 'aria-current="page"' : '' }}>Puer natus est</a></li>
                <li><a href="{{ path('paleo_viderunt') }}"   {{ nav_actif == 'viderunt' ? 'aria-current="page"' : '' }}>Viderunt omnes</a></li>
                <li><a href="{{ path('paleo_lux') }}"        {{ nav_actif == 'lux'      ? 'aria-current="page"' : '' }}>Lux fulgebit</a></li>
                <li><a href="{{ path('paleo_victimae') }}"   {{ nav_actif == 'victimae' ? 'aria-current="page"' : '' }}>Victimæ paschali</a></li>
                <li><a href="{{ path('paleo_alleluia_noel') }}"   {{ nav_actif == 'alleluia_noel'   ? 'aria-current="page"' : '' }}>Alleluia (Noël)</a></li>
                <li><a href="{{ path('paleo_alleluia_paques') }}" {{ nav_actif == 'alleluia_paques' ? 'aria-current="page"' : '' }}>Alleluia (Pâques)</a></li>
                <li><a href="{{ path('paleo_glossaire') }}"  {{ nav_actif == 'glossaire'? 'aria-current="page"' : '' }}>Glossaire</a></li>
                <li><a href="{{ path('paleo_apropos') }}"    {{ nav_actif == 'apropos'  ? 'aria-current="page"' : '' }}>À propos</a></li>
            </ul>
        </nav>

        <main>
            {% block contenu %}{% endblock %}
        </main>
    </div>

    <footer class="site-footer">
        <div class="inner">
            <p>
                <a class="btn-pdf" href="{{ asset('assets/paleo-blog.pdf') }}" download>
                    ⬇ Télécharger le blog en PDF (A4)
                </a>
            </p>
            <p><strong>Vous avez dit «&nbsp;grégorien&nbsp;»&nbsp;?</strong> — Le chant grégorien et ses neumes, expliqués pas à pas.</p>
            <p>&copy;&nbsp;Marie-Noëlle Kreilos 2026</p>
        </div>
    </footer>
</body>
</html>
