<form class="form-feedback" id="form-feedback" novalidate>
    <div class="form-ligne">
        <label for="ff-name">Nom <span class="optionnel">(facultatif)</span></label>
        <input type="text" id="ff-name" name="name" autocomplete="name" maxlength="200">
    </div>
    <div class="form-ligne">
        <label for="ff-email">E-mail <span class="optionnel">(facultatif, pour une réponse)</span></label>
        <input type="email" id="ff-email" name="email" autocomplete="email">
    </div>
    <div class="form-ligne">
        <label for="ff-message">Votre message</label>
        <textarea id="ff-message" name="message" rows="5" required maxlength="8000"></textarea>
    </div>
    <div class="form-piege" aria-hidden="true">
        <label for="ff-website">Site web</label>
        <input type="text" id="ff-website" name="website" tabindex="-1" autocomplete="off">
    </div>
    <button type="submit" class="btn-form">Envoyer</button>
    <p class="form-statut" id="form-statut" role="status" aria-live="polite"></p>
</form>

<script>
(function () {
    var form = document.getElementById('form-feedback');
    if (!form) return;
    var statut = document.getElementById('form-statut');
    var btn = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.message.value.trim()) {
            statut.textContent = 'Merci d’écrire un message avant d’envoyer.';
            statut.className = 'form-statut erreur';
            return;
        }
        var data = {
            name: form.name.value,
            email: form.email.value,
            message: form.message.value,
            website: form.website.value,
            lang: 'fr',
            page: window.location.pathname
        };
        btn.disabled = true;
        statut.textContent = 'Envoi en cours…';
        statut.className = 'form-statut';
        fetch('/api/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (j) {
                return { ok: r.ok, body: j };
            });
        }).then(function (res) {
            btn.disabled = false;
            if (res.ok && res.body && res.body.ok) {
                form.reset();
                statut.textContent = 'Merci, votre message a bien été envoyé !';
                statut.className = 'form-statut ok';
            } else {
                statut.textContent = 'Une erreur est survenue — vous pouvez aussi écrire directement à marino@kreilos.com.';
                statut.className = 'form-statut erreur';
            }
        }).catch(function () {
            btn.disabled = false;
            statut.textContent = 'Une erreur est survenue — vous pouvez aussi écrire directement à marino@kreilos.com.';
            statut.className = 'form-statut erreur';
        });
    });
})();
</script>

