<script>
(function () {
    var form = document.getElementById('form-feedback');
    if (!form) return;
    var statut = document.getElementById('form-statut');
    var btn = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.message.value.trim()) {
            statut.textContent = 'Merci d’écrire un message avant d’envoyer.';
            statut.className = 'form-statut erreur';
            return;
        }
        var data = {
            name: form.name.value,
            email: form.email.value,
            message: form.message.value,
            website: form.website.value,
            lang: 'fr',
            page: window.location.pathname
        };
        btn.disabled = true;
        statut.textContent = 'Envoi en cours…';
        statut.className = 'form-statut';
        fetch('/api/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (j) {
                return { ok: r.ok, body: j };
            });
        }).then(function (res) {
            btn.disabled = false;
            if (res.ok && res.body && res.body.ok) {
                form.reset();
                statut.textContent = 'Merci, votre message a bien été envoyé !';
                statut.className = 'form-statut ok';
            } else {
                statut.textContent = 'Une erreur est survenue — vous pouvez aussi écrire directement à marino@kreilos.com.';
                statut.className = 'form-statut erreur';
            }
        }).catch(function () {
            btn.disabled = false;
            statut.textContent = 'Une erreur est survenue — vous pouvez aussi écrire directement à marino@kreilos.com.';
            statut.className = 'form-statut erreur';
        });
    });
})();
</script>

