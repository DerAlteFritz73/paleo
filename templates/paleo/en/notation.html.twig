<script>
(function () {
    var overlay = document.createElement('div');
    overlay.className = 'lightbox-overlay';
    overlay.hidden = true;
    overlay.innerHTML = '<div class="lightbox-content">'
        + '<button type="button" class="lightbox-close" aria-label="Close">✕</button>'
        + '<div class="lightbox-body"></div>'
        + '<p class="lightbox-caption"></p>'
        + '</div>';
    document.body.appendChild(overlay);
    var body = overlay.querySelector('.lightbox-body');
    var caption = overlay.querySelector('.lightbox-caption');
    var closeBtn = overlay.querySelector('.lightbox-close');

    function openLightbox(el) {
        body.innerHTML = '';
        var clone = el.cloneNode(true);
        clone.classList.remove('zoomable', 'mini-neume');
        body.appendChild(clone);
        caption.textContent = el.getAttribute('alt') || el.getAttribute('aria-label') || '';
        overlay.hidden = false;
    }
    function closeLightbox() { overlay.hidden = true; }

    var zoomables = document.querySelectorAll('.zoomable');
    for (var i = 0; i < zoomables.length; i++) {
        zoomables[i].addEventListener('click', (function (el) {
            return function () { openLightbox(el); };
        })(zoomables[i]));
    }
    overlay.addEventListener('click', function (e) {
        if (e.target === overlay) closeLightbox();
    });
    closeBtn.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeLightbox();
    });
})();
</script>
