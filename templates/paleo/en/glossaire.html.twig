    <button type="submit" class="btn-form">Send</button>
    <p class="form-statut" id="form-statut" role="status" aria-live="polite"></p>
</form>

<script>
(function () {
    var form = document.getElementById('form-feedback');
    if (!form) return;
    var statut = document.getElementById('form-statut');
    var btn = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.message.value.trim()) {
            statut.textContent = 'Please write a message before sending.';
            statut.className = 'form-statut erreur';
            return;
        }
        var data = {
            name: form.name.value,
            email: form.email.value,
            message: form.message.value,
            website: form.website.value,
            lang: 'en',
            page: window.location.pathname
        };
        btn.disabled = true;
        statut.textContent = 'Sending…';
        statut.className = 'form-statut';
        fetch('/api/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (j) {
                return { ok: r.ok, body: j };
            });
        }).then(function (res) {
            btn.disabled = false;
            if (res.ok && res.body && res.body.ok) {
                form.reset();
                statut.textContent = 'Thank you, your message has been sent!';
                statut.className = 'form-statut ok';
            } else {
                statut.textContent = 'Something went wrong — you can also write to us directly at marino@kreilos.com.';
                statut.className = 'form-statut erreur';
            }
        }).catch(function () {
            btn.disabled = false;
            statut.textContent = 'Something went wrong — you can also write to us directly at marino@kreilos.com.';
            statut.className = 'form-statut erreur';
        });
    });
})();
</script>

