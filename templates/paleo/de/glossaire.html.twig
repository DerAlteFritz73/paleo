<script>
(function () {
    var form = document.getElementById('form-feedback');
    if (!form) return;
    var statut = document.getElementById('form-statut');
    var btn = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.message.value.trim()) {
            statut.textContent = 'Bitte schreiben Sie eine Nachricht, bevor Sie senden.';
            statut.className = 'form-statut erreur';
            return;
        }
        var data = {
            name: form.name.value,
            email: form.email.value,
            message: form.message.value,
            website: form.website.value,
            lang: 'de',
            page: window.location.pathname
        };
        btn.disabled = true;
        statut.textContent = 'Wird gesendet…';
        statut.className = 'form-statut';
        fetch('/api/feedback', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        }).then(function (r) {
            return r.json().catch(function () { return {}; }).then(function (j) {
                return { ok: r.ok, body: j };
            });
        }).then(function (res) {
            btn.disabled = false;
            if (res.ok && res.body && res.body.ok) {
                form.reset();
                statut.textContent = 'Vielen Dank, Ihre Nachricht wurde gesendet!';
                statut.className = 'form-statut ok';
            } else {
                statut.textContent = 'Es ist ein Fehler aufgetreten — Sie können uns auch direkt unter marino@kreilos.com schreiben.';
                statut.className = 'form-statut erreur';
            }
        }).catch(function () {
            btn.disabled = false;
            statut.textContent = 'Es ist ein Fehler aufgetreten — Sie können uns auch direkt unter marino@kreilos.com schreiben.';
            statut.className = 'form-statut erreur';
        });
    });
})();
</script>

